{
  "name": "@chivago/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\" && node --test --test-force-exit --experimental-strip-types --import ./test/register.mjs \"test/*.test.ts\"",
    "export:live": "node scripts/export-live.mjs",
    "demo:web": "node scripts/export-demo.mjs",
    "demo:deploy": "wrangler deploy -c demo.wrangler.jsonc"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@chivago/core": "workspace:*",
    "@chivago/tokens": "workspace:*",
    "@expo-google-fonts/anuphan": "^0.4.1",
    "@expo-google-fonts/archivo": "^0.2.3",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans-thai": "^0.4.1",
    "@expo-google-fonts/noto-sans-thai": "^0.2.3",
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.10",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "lucide-react-native": "^0.511.0",
    "maplibre-gl": "6.19.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "13.15.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.1.17",
    "@types/three": "0.170.0",
    "fake-indexeddb": "^6.2.7",
    "react-test-renderer": "19.1.0",
    "sucrase": "^3.35.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.160.1"
  }
}
