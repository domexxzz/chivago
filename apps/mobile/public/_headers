# Cache rules for the exported web app, as Workers Assets actually reads them.
#
# THESE LIVED IN `wrangler.jsonc` AND DID NOTHING. A top-level `headers` key is
# not part of the Worker configuration, and wrangler says so on every deploy -
#   Unexpected fields found in top-level field: "headers"
# - which is a warning in a wall of output that nobody reads twice. The rules
# were written with care, measured against venue wifi, and were being dropped
# in silence. Workers Assets reads this file instead, and `public/` is copied
# into the export verbatim, so it ships with the build and needs no step.
#
# WHY THESE NUMBERS. The bundle is 3.9 MB uncompressed and venue wifi, not CPU,
# is what falls over when a room opens the app at once. Expo stamps a content
# hash into bundle and asset names, so those are immutable for a year: a new
# build is a new name and there is nothing to invalidate. The place
# photographs under /media are NOT hashed (`ku-park.jpg`), so an hour - long
# enough for that room, short enough that replacing one is not a support call.
#
# index.html is `no-cache`, which means REVALIDATE, not do-not-store. That is
# what makes a deploy visible immediately while costing one 304 instead of
# re-sending the document.

/_expo/*
  cache-control: public, max-age=31536000, immutable

/assets/*
  cache-control: public, max-age=31536000, immutable

/media/*
  cache-control: public, max-age=3600

# The island is 602 KB and its name is NOT content-hashed, so "immutable" would
# strand a rebuild behind a year of caches. An hour is the same bargain /media
# makes: a room that opens the app together pays once, and replacing the model
# is not a support call.
# CORS, AND THE ISLAND NEVER LOADED WITHOUT IT.
#
# A WebView handed bare HTML has an OPAQUE origin, and so does an iframe with
# srcDoc - which is both of the places the diorama runs. Every request such a
# page makes is cross-origin, and an ES module import is always fetched in
# CORS mode. Without this header the browser refused the import before a line
# of our code ran, so nothing could report the failure: the page sat on
# "Building the island" for ever, which reads as slow rather than as broken.
# Three rounds were spent making the files smaller. They were never arriving.
/islands/*
  cache-control: public, max-age=3600
  access-control-allow-origin: *

# three.js, served from here rather than a CDN: 675 KB over somebody else's
# DNS and TLS was most of the wait before the island appeared. The version is
# in the filename, so this one IS immutable - a new three is a new name.
/vendor/*
  cache-control: public, max-age=31536000, immutable
  access-control-allow-origin: *

/favicon.ico
  cache-control: public, max-age=86400

/icons/*
  cache-control: public, max-age=86400

# The promo page. Its HTML revalidates like index.html so an edit shows at
# once; its images are not content-hashed, so they get the /media hour.
/th/
  cache-control: no-cache

/th/img/*
  cache-control: public, max-age=3600

/
  cache-control: no-cache

/index.html
  cache-control: no-cache
