{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src"],
  // Typechecked by tsconfig.worker.json instead: its globals are Cloudflare's,
  // not Node's, and the two type packages conflict in one project.
  "exclude": ["src/worker.ts", "src/worker-alarm-fixture.ts"]
}
