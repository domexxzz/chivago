{
  "name": "@chivago/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "seed": "node --experimental-strip-types src/seed-db.ts",
  "host:add": "node --experimental-strip-types src/add-host.ts",
    "test": "node --test --experimental-strip-types \"src/*.test.ts\" \"src/console/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "contract": "node --experimental-strip-types src/capture-contract.ts",
    "demo:reset": "node --experimental-strip-types src/reset-demo.ts",
    "demo:capture": "node --experimental-strip-types src/capture-demo.ts"
  },
  "dependencies": {
    "@chivago/core": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
