# Dependencies
node_modules/
.pnpm-store/

# Build output. Regenerated by `expo export`; see apps/mobile/scripts/flatten-assets.mjs
#
# `dist/` alone was not enough. Each web export went to a fresh directory -
# dist2, dist3, dist4 - and none of them matched, so 93 generated files and
# 18 MB got committed. The glob covers the numbered ones and dist-demo too.
dist*/
build/
.expo/
web-build/

# Databases. These carry real seeded host api_key_hash values and traveller
# data, and they are rebuilt by `pnpm --filter @chivago/api seed`. A database
# in version control is a credential store in version control.
*.db
*.db-shm
*.db-wal
apps/api/data/

# Secrets and deploy identity
.env
.env.*
!.env.example
.vercel/

# Captured API responses used to keep the three clients in step are TRACKED
# (`contract/*.json`), on purpose. They were ignored for the first forty
# commits, which meant `pnpm test` failed on every fresh clone and the drift
# guard had no baseline to diff against - so it never fired, while the API
# renamed a field the SDKs still decode. Regenerate with
# `pnpm --filter @chivago/api contract` against a running server, and review
# the diff like any other contract change.

# Design handoff archive and its extraction. Large, binary, and already
# distilled into packages/tokens.
*.zip
_extracted/

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Logs
*.log
npm-debug.log*

# Dart tooling output, regenerated by `dart pub get`
.dart_tool/

# The Thai review page, regenerated by `pnpm thai:review`. Corrections come
# back as JSON and go through `pnpm thai:apply`; the page itself is output.
thai-review.html
