# Copy to `.env` and fill in. `.env` is ignored by git and must stay that way:
# the webhook below lets whoever holds it post into the team's channel as this
# app, and is a credential like any other.

# Where `scripts/announce.mjs` posts what changed.
# Discord → Server Settings → Integrations → Webhooks → Copy Webhook URL
CHIVAGO_DISCORD_WEBHOOK=

# The memory service on the developer's own machine (sentiara-ai, port 8770).
# Optional: with nothing running there the announcement still reaches Discord
# and the script says which of the two landed.
CHIVAGO_HERMES_URL=http://localhost:8770

# Insert-only Ko Sichang production content. Credentials remain secrets and
# must never be committed. Leaving the switch unset makes startup do nothing.
CHIVAGO_BOOTSTRAP_KOH_SICHANG=
# Optional and off by default: service profiles belong to their operator.
CHIVAGO_BOOTSTRAP_KOH_SICHANG_BUSINESSES=
CHIVAGO_BOOTSTRAP_OPERATOR_PASSWORD=
CHIVAGO_BOOTSTRAP_OPERATOR_PHONE=

# Chivar Bot language understanding through Groq. The API key is server-only:
# never prefix it with EXPO_PUBLIC_ and never put it in the mobile bundle.
CHIVAGO_GROQ=on
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional, accepted range 1000-30000. Defaults to 8000.
GROQ_TIMEOUT_MS=8000
# Retry only transient timeout/rate-limit/server errors. Accepted range 0-2.
GROQ_RETRIES=1
# Shared-key ceiling across all users and retries in this deployment (1-10000).
GROQ_GLOBAL_REQUESTS_PER_MINUTE=120

# Thai Meteorological Department NWP API token (data.tmd.go.th), server-only.
# With it, each weather reading is cross-checked against TMD's forecast for the
# same hour and marked "estimated" when the two disagree (apps/api/src/tmd.ts).
# Empty means no cross-check; nothing else changes. Expires a year after issue.
TMD_NWP_TOKEN=

# The camera bridge: Sentiara AI's detector on Ko Sichang posts incidents to
# POST /integrations/sentiara/incident, signed with an HMAC over the raw body.
# BOTH SIDES HOLD THE SAME SECRET - it is their CHIVARGO_SHARED_SECRET - and it
# must be at least 24 characters, which is the floor both senders apply. Unset
# or shorter and the route answers 404 like any unknown path: there is nothing
# honest to do with an incident nobody can verify, and a distinctive refusal
# would announce that the route exists. See
# docs/sentiara-integration-questions.md for the whole contract.
CHIVAGO_SENTIARA_SECRET=
# Where a human's decision is reported back, signed with the same secret.
# Unset means decisions are recorded and never reported, and the desk counts
# them as awaiting a report rather than as sent.
CHIVAGO_SENTIARA_OUTCOME_URL=
# How long after the last report on a camera a new one is the same event.
# Optional, defaults to 1800 - three of Sentiara's ten-minute windows, so a
# vehicle that sits across the pier stays one job instead of becoming a new
# one every half hour.
CHIVAGO_SENTIARA_MERGE_SEC=1800

# Thai Meteorological Department station and warnings (server-only). The Ko
# Sichang station (WMO 48460) and the official warning list are read with the
# legacy credentials registered at https://data.tmd.go.th/api/. Without them
# the card shows Open-Meteo, checked against the NWP token above.
TMD_API_UID=
TMD_API_KEY=
