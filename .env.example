# Copy to `.env` and fill in. `.env` is ignored by git and must stay that way:
# the webhook below lets whoever holds it post into the team's channel as this
# app, and is a credential like any other.

# Where `scripts/announce.mjs` posts what changed.
# Discord → Server Settings → Integrations → Webhooks → Copy Webhook URL
CHIVAGO_DISCORD_WEBHOOK=

# The memory service on the developer's own machine (sentiara-ai, port 8770).
# Optional: with nothing running there the announcement still reaches Discord
# and the script says which of the two landed.
CHIVAGO_HERMES_URL=http://localhost:8770
