{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@chivago/api",
        "dev"
      ],
      "port": 8787,
      "url": "http://localhost:8787"
    },
    {
      "name": "mobile",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@chivago/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--clear"
      ],
      "port": 8081,
      "url": "http://localhost:8081"
    },
    {
      "name": "demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/mobile/scripts/serve-demo.mjs",
        "apps/mobile/dist-demo",
        "4173"
      ],
      "port": 4173,
      "url": "http://localhost:4173"
    },
    {
      "name": "qa",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/mobile/scripts/serve-demo.mjs",
        "apps/mobile/dist-qa",
        "4174"
      ],
      "port": 4174,
      "url": "http://localhost:4174"
    },
    {
      "name": "live",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/mobile/scripts/serve-demo.mjs",
        "apps/mobile/dist-live",
        "4175"
      ],
      "port": 4175,
      "url": "http://localhost:4175"
    },
    {
      "name": "site",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),fs=require('fs'),p=require('path');const r=p.resolve('apps/mobile/public');const t={'.html':'text/html; charset=utf-8','.webp':'image/webp','.png':'image/png','.jpg':'image/jpeg','.txt':'text/plain; charset=utf-8','.xml':'application/xml'};h.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u.endsWith('/'))u+='index.html';const f=p.join(r,u);if(!f.startsWith(r)||!fs.existsSync(f)){s.writeHead(404);return s.end('nf')}s.writeHead(200,{'content-type':t[p.extname(f)]||'application/octet-stream'});fs.createReadStream(f).pipe(s)}).listen(4321)"
      ],
      "port": 4321
    }
  ]
}