{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@chivago/api", "dev"],
      "port": 8787,
      "url": "http://localhost:8787"
    },
    {
      "name": "mobile",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@chivago/mobile", "exec", "expo", "start", "--web", "--clear"],
      "port": 8081,
      "url": "http://localhost:8081"
    },
    {
      "name": "demo",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4173", "--directory", "apps/mobile/dist-demo"],
      "port": 4173,
      "url": "http://localhost:4173"
    }
  ]
}
